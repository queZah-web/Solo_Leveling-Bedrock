{
  "format_version": "1.10.0",
  "minecraft:client_entity": {
    "description": {
      "identifier": "sl:shadow_ice_elf",
      "materials": {
        "default": "entity_alphatest"
      },
      "textures": {
        "default": "textures/sl/models/shadow_ice_elf"
      },
      "geometry": {
        "default": "geometry.sl.m_shadow_ice_elf"
      },
      "animations": {
        "walk": "animation.sl.m_shadow_ice_elf.walk",
        "idle": "animation.sl.m_shadow_ice_elf.idle",
        "attack": "animation.sl.m_shadow_ice_elf.attack",
        "look": "animation.sl.look_at_target"
      },
      "scripts": {
        "animate": [
          "walk",
          "idle",
          "look",
          {
            "attack": "variable.attack_time > 0.0"
          }
        ]
      },
      "render_controllers": [
        "controller.render.sl_shadow_custom"
      ],
      "enable_attachables": true
    }
  }
}